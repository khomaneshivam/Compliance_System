# ==============================================================================
# PlantProof Enterprise Regulatory Intelligence - Environment Configuration
# ==============================================================================
# COPY THIS FILE TO .env AND UPDATE FOR YOUR LOCAL ENVIRONMENT.
# ALL VALUES IN THIS TEMPLATE ARE SYNTHETIC PLACEHOLDERS FOR SAFE DEVELOPMENT.
# NEVER COMMIT REAL SECRETS OR PRODUCTION PASSWORDS TO SOURCE CONTROL.
# ==============================================================================

# Application Metadata
PROJECT_NAME="PlantProof"
VERSION="1.0.0"
ENVIRONMENT="development"
DEBUG=true
API_V1_STR="/api/v1"

# Security & Authentication
# In production: Must be set to a high-entropy secret (e.g. openssl rand -hex 32).
# Production mode strictly rejects default/placeholder keys and requires DEBUG=false.
SECRET_KEY="demo-fake-secret-key-do-not-use-in-production-plantproof-auth"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Seeding & Schema Management Policy
# SEED_DEMO_USERS: Explicitly allow demo persona & tenant seeding (only permitted in development/test)
SEED_DEMO_USERS=true
# AUTO_MIGRATE_ON_STARTUP: Auto-create tables on startup (only used in development/test with local database; production uses Alembic)
AUTO_MIGRATE_ON_STARTUP=true

# Database Configuration
# Default: Zero-dependency local SQLite database
DATABASE_URL="sqlite:///./plantproof.db"


# Optional: Enterprise PostgreSQL configuration (Uncomment to use PostgreSQL)
# POSTGRES_USER="plantproof_user"
# POSTGRES_PASSWORD="fake_db_password_placeholder_123"
# POSTGRES_SERVER="localhost"
# POSTGRES_PORT=5432
# POSTGRES_DB="plantproof_dev"
# DATABASE_URL="postgresql+psycopg2://plantproof_user:fake_db_password_placeholder_123@localhost:5432/plantproof_dev"

# Database Connection Pool (PostgreSQL / SQLite)
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_PRE_PING=true
DB_ECHO=false

# Background Worker & Cache (Redis - Optional for local zero-dependency testing)
REDIS_ENABLED=false
REDIS_URL="redis://localhost:6379/0"

# Document Vault Storage
STORAGE_DIR="./storage/vault"
MAX_UPLOAD_SIZE_BYTES=26214400  # 25 MB (25 * 1024 * 1024)

# Notifications & Alerts Delivery
# Options: "console" (logs to stdout), "test" (in-memory test adapter), "smtp" (real email)
NOTIFICATION_DELIVERY_MODE="console"
# SMTP Settings (Required only if NOTIFICATION_DELIVERY_MODE="smtp")
# SMTP_HOST="smtp.example.com"
# SMTP_PORT=587
# SMTP_USER="compliance@example.com"
# SMTP_PASSWORD="smtp_password_here"
# SMTP_TLS=true
EMAILS_FROM_EMAIL="notifications@plantproof.internal"
EMAILS_FROM_NAME="PlantProof Compliance"

# Structured Logging
LOG_LEVEL="INFO"
LOG_FORMAT="json"

# CORS Allowed Origins (Comma-separated list or JSON array)
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173","http://127.0.0.1:3000"]
